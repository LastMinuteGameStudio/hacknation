# Publiczny adres aplikacji: z niego generujemy linki /d/{slug}.csv. Z tunelem: adres przypisany tunelowi w Cloudflare (np. https://aed.example.pl)
BASE_URL=http://localhost:8000
# Port tylko dla docker-compose.dev.yml (127.0.0.1)
PORT=8000
# auto = atrapy, gdy rdzeń zgłasza NotImplementedError; 1 = zawsze atrapy; 0 = nigdy
MOCK=auto
# Token tunelu nazwanego Cloudflare (Zero Trust → Networks → Tunnels). Public hostname tunelu → http://app:8000. Nie commitować.
TUNNEL_TOKEN=
