# Publiczny adres aplikacji: z niego generujemy linki /d/{slug}.csv.
# Z tunelem: adres przypisany tunelowi w Cloudflare (np. https://aed.<domena-wojtka>). Lokalnie: http://localhost:8000
BASE_URL=http://localhost:8000
# Token tunelu nazwanego Cloudflare (od Wojtka). Nie commitujemy .env.
TUNNEL_TOKEN=
# Port na 127.0.0.1 tylko w trybie lokalnym (docker-compose.dev.yml)
PORT=8000
# auto = atrapy, gdy rdzeń zgłasza NotImplementedError; 1 = zawsze atrapy; 0 = nigdy
MOCK=auto
