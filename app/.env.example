# Publiczny adres aplikacji: z niego generujemy linki /d/{slug}.csv.
# Z tunelem (demo): https://tuaed.wkrynski.dev. Lokalnie bez tunelu: http://localhost:8000 (albo port z PORT).
BASE_URL=https://tuaed.wkrynski.dev
# Token tunelu nazwanego Cloudflare (od Wojtka). Nie commitujemy .env.
TUNNEL_TOKEN=
# Port na 127.0.0.1 tylko w trybie lokalnym (docker-compose.dev.yml)
PORT=8000
# auto = atrapy, gdy rdzeń zgłasza NotImplementedError; 1 = zawsze atrapy; 0 = nigdy
MOCK=auto
# Nazwa projektu compose: KAŻDY klon musi mieć inną (np. aed-b-api), bo wszystkie leżą w katalogu app/
# i bez tego podmieniają sobie kontenery. Demo z tunelem: tuaed.
COMPOSE_PROJECT_NAME=aed-lokalnie
